;;;; On-demand download of the prebuilt openDAQ native libraries.
;;;;
;;;; An end-user checkout (e.g. installed through Quicklisp) carries no native
;;;; libraries.  On first load the loader in runtime.lisp falls back to
;;;; INSTALL-NATIVE-LIBRARIES below, which fetches the archive for the current
;;;; platform from the GitHub release pinned in native-binaries.sexp, verifies
;;;; its SHA256 and unpacks it into the per-user XDG cache directory.  The
;;;; manifest is generated by .github/workflows/build-native-binaries.yml.
;;;;
;;;; Downloading and unpacking shell out to curl and tar, which ship with
;;;; Linux, macOS and Windows 10+.  Quicklisp offers no facility for this
;;;; (its internal ql-http client cannot even speak HTTPS), and doing it in
;;;; Lisp would drag in an HTTPS client plus an archive library.
;;;;
;;;; Loaded right after package.lisp so that runtime.lisp can call into it
;;;; when it autoloads the libraries at load time.

(in-package #:opendaq.low-level)

(defparameter +native-directory-env-var+ "OPENDAQ_LISP_NATIVE_DIR")
(defparameter +no-download-env-var+ "OPENDAQ_NO_DOWNLOAD")
(defparameter +archive-url-env-var+ "OPENDAQ_NATIVE_ARCHIVE_URL")
(defparameter +native-manifest-file-name+ "native-binaries.sexp")

(defparameter +native-library-file-names+
  ;; Exact file names shipped in bin/<platform>/, in dependency load order.
  #+linux
  '("libdaqcoretypes-64-3.so"
    "libdaqcoreobjects-64-3.so"
    "libopendaq-64-3.so"
    "libcopendaq.so")
  #+darwin
  '("libdaqcoretypes-64-3.dylib"
    "libdaqcoreobjects-64-3.dylib"
    "libopendaq-64-3.dylib"
    "libcopendaq.dylib")
  #+(or windows win32)
  '("daqcoretypes-64-3.dll"
    "daqcoreobjects-64-3.dll"
    "opendaq-64-3.dll"
    "copendaq.dll")
  #-(or linux darwin windows win32)
  (error "Unsupported OS for openDAQ native libraries: ~A" (software-type)))

(defun %current-platform-directory-name ()
  "Name of the bin/ subdirectory holding this host's native libraries, e.g.
\"linux-x64\".  The OS and architecture are selected from *FEATURES* at read
time rather than sniffed from SOFTWARE-TYPE / MACHINE-TYPE strings."
  (let ((os #+linux "linux"
            #+darwin "darwin"
            #+(or windows win32) "windows"
            #-(or linux darwin windows win32)
            (error "Unsupported OS for openDAQ native libraries: ~A"
                   (software-type)))
        (arch #+(or x86-64 x86_64 amd64) "x64"
              #+(or arm64 aarch64) "arm64"
              #-(or x86-64 x86_64 amd64 arm64 aarch64)
              (error "Unsupported architecture for openDAQ native libraries: ~A"
                     (machine-type))))
    (format nil "~A-~A" os arch)))

(defun %native-archive-manifest ()
  "Parsed native-binaries.sexp manifest shipped with the system, or NIL when
this checkout has no pinned binaries release."
  (let ((path (ignore-errors
                (asdf:system-relative-pathname "opendaq"
                                               +native-manifest-file-name+))))
    (when (and path (probe-file path))
      (with-open-file (stream path)
        (with-standard-io-syntax
          (let ((*read-eval* nil))
            (read stream)))))))

(defun %manifest-archive-entry (manifest platform)
  (assoc platform (getf manifest :archives) :test #'string=))

(defun %cache-native-root (manifest)
  (uiop:xdg-cache-home (format nil "cl-opendaq/~A/" (getf manifest :tag))))

(defun %cache-platform-directory (manifest platform)
  (merge-pathnames (format nil "~A/" platform) (%cache-native-root manifest)))

(defun %directory-has-all-libraries-p (directory)
  (and directory
       (every (lambda (file-name)
                (probe-file (merge-pathnames file-name directory)))
              +native-library-file-names+)))

(defun %downloads-disabled-p ()
  (let ((value (uiop:getenv +no-download-env-var+)))
    (and value (plusp (length value)))))

(defun %environment-archive-url ()
  (let ((value (uiop:getenv +archive-url-env-var+)))
    (when (and value (plusp (length value)))
      value)))

(defun %run-tool (command description)
  (multiple-value-bind (output error-output exit-code)
      (handler-case
          (uiop:run-program command
                            :output '(:string :stripped t)
                            :error-output '(:string :stripped t)
                            :ignore-error-status t)
        (error (condition)
          (error "~A: could not run ~S: ~A" description (first command)
                 condition)))
    (unless (zerop exit-code)
      (error "~A: `~{~A~^ ~}` exited with code ~A~@[: ~A~]"
             description command exit-code
             (and (stringp error-output)
                  (plusp (length error-output))
                  error-output)))
    output))

(defun %download-file (url target)
  (ensure-directories-exist target)
  (%run-tool (list "curl" "--fail" "--location" "--silent" "--show-error"
                   "--output" (uiop:native-namestring target)
                   url)
             (format nil "Downloading ~A" url))
  (or (probe-file target)
      (error "Downloading ~A produced no file at ~A." url
             (namestring target))))

(defun %extract-archive (archive directory)
  (ensure-directories-exist directory)
  (%run-tool (list "tar" "-xzf" (uiop:native-namestring archive)
                   "-C" (uiop:native-namestring directory))
             (format nil "Extracting ~A" (namestring archive))))

(defun %sha256-hex-p (value)
  (and (stringp value)
       (= (length value) 64)
       (every (lambda (char) (digit-char-p char 16)) value)))

(defun %file-sha256 (path)
  "Hex SHA256 digest of PATH computed with whichever hashing tool the host
provides, or NIL when none is available."
  (let ((native (uiop:native-namestring path)))
    (flet ((try (command extract)
             (ignore-errors
               (let* ((output (uiop:run-program command
                                                :output '(:string :stripped t)
                                                :error-output nil))
                      (digest (funcall extract output)))
                 (when (%sha256-hex-p digest)
                   digest)))))
      (or (try (list "sha256sum" native)
               (lambda (output) (subseq output 0 64)))
          (try (list "shasum" "-a" "256" native)
               (lambda (output) (subseq output 0 64)))
          ;; certutil prints the digest on its second output line.
          (try (list "certutil" "-hashfile" native "SHA256")
               (lambda (output)
                 (let ((lines (uiop:split-string output
                                                 :separator '(#\Newline))))
                   (remove-if (lambda (char)
                                (member char '(#\Space #\Return)))
                              (or (second lines) "")))))))))

(defun %verify-archive-checksum (archive expected-sha256 skip-reason)
  (cond
    (skip-reason
     (warn "Skipping SHA256 verification of ~A: ~A"
           (namestring archive) skip-reason))
    ((not (%sha256-hex-p expected-sha256))
     (warn "The ~A manifest carries no SHA256 for ~A; skipping verification."
           +native-manifest-file-name+ (namestring archive)))
    (t
     (let ((actual (%file-sha256 archive)))
       (cond
         ((null actual)
          (warn "No SHA256 tool (sha256sum, shasum or certutil) is available; skipping checksum verification of ~A."
                (namestring archive)))
         ((string-equal actual expected-sha256)
          t)
         (t
          (delete-file archive)
          (error "SHA256 mismatch for ~A: expected ~A but got ~A. The download may be corrupted or tampered with; the file has been deleted."
                 (namestring archive) expected-sha256 actual)))))))

(defun install-native-libraries (&key (platform
                                       (%current-platform-directory-name))
                                      force)
  "Download the openDAQ native libraries for PLATFORM from the GitHub release
pinned in native-binaries.sexp, unpack them into the per-user cache directory
and return that directory.  Already-cached libraries are reused unless FORCE
is true.  Set OPENDAQ_NATIVE_ARCHIVE_URL to fetch the archive from a mirror
instead of the pinned release."
  (let ((manifest (%native-archive-manifest)))
    (unless manifest
      (error "This copy of the opendaq system ships no ~A manifest, so there is no pinned release to download native libraries from. Build them locally with `make bindings` or set ~A to an existing openDAQ installation."
             +native-manifest-file-name+ +native-directory-env-var+))
    (let* ((entry (or (%manifest-archive-entry manifest platform)
                      (error "Release ~A has no native library archive for platform ~A (available: ~{~A~^, ~})."
                             (getf manifest :tag) platform
                             (mapcar #'first (getf manifest :archives)))))
           (file-name (second entry))
           (expected-sha256 (third entry))
           (target (%cache-platform-directory manifest platform))
           (current-platform-p
             (string= platform (%current-platform-directory-name))))
      (when (and current-platform-p
                 (not force)
                 (%directory-has-all-libraries-p target))
        (return-from install-native-libraries target))
      (let* ((override-url (%environment-archive-url))
             (url (or override-url
                      (concatenate 'string (getf manifest :base-url)
                                   file-name)))
             (archive (merge-pathnames file-name
                                       (%cache-native-root manifest))))
        (format *error-output*
                "~&; opendaq: downloading native libraries (~A, release ~A)~%   from ~A~%   into ~A~%"
                platform (getf manifest :tag) url (namestring target))
        (%download-file url archive)
        (%verify-archive-checksum
         archive expected-sha256
         (when override-url
           (format nil "~A overrides the pinned release URL."
                   +archive-url-env-var+)))
        (%extract-archive archive target)
        (delete-file archive)
        (when (and current-platform-p
                   (not (%directory-has-all-libraries-p target)))
          (error "The downloaded archive ~A did not contain all expected openDAQ libraries (~{~A~^, ~})."
                 file-name +native-library-file-names+))
        target))))

(defun %cached-native-directory (manifest)
  (let ((directory (%cache-platform-directory
                    manifest (%current-platform-directory-name))))
    (when (%directory-has-all-libraries-p directory)
      directory)))
